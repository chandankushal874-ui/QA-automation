# Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://cbtp:cbtp_dev_password@localhost:5432/cbtp
DATABASE_URL_SYNC=postgresql://cbtp:cbtp_dev_password@localhost:5432/cbtp

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cbtp_minio
S3_SECRET_KEY=cbtp_minio_password
S3_BUCKET_NAME=cbtp-artifacts

# OpenRouter (LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# GitHub (for PR automation)
GITHUB_TOKEN=your_github_token_here

# E2B (remote sandbox for fix verification)
E2B_API_KEY=your_e2b_api_key_here
E2B_SANDBOX_TIMEOUT=120

# Firecrawl (optional)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Platform settings
MAX_CRAWL_DEPTH=10
MAX_PAGES_PER_JOB=1000
MAX_CRAWL_TIME_SECONDS=3600
PER_ENDPOINT_VISIT_BUDGET=5
CIRCUIT_BREAKER_THRESHOLD=10

# Fixture app (for testing)
FIXTURE_APP_URL=http://localhost:8090

# Multi-user auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# username:password:email pairs (comma-separated)
SEED_USERS=user1:user123:user1@localhost,user2:user123:user2@localhost
# Set true only for local tests without login
AUTH_DISABLED=false
JWT_SECRET=

# ── Enterprise auth controls ──
# Audit log (append-only; admin reads via GET /api/auth/audit)
AUDIT_LOG_ENABLED=true
# TOTP MFA (per-user opt-in via /api/auth/mfa/setup; false disables the feature)
MFA_ENABLED=true

# Real IdP login via OIDC (Google setup: Google Cloud Console → APIs & Services
# → Credentials → Create OAuth 2.0 Client ID (Web) → add the redirect URI below)
OIDC_ENABLED=false
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8001/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
# Where the browser lands after IdP login (JWT appended as #token=). Empty = JSON response.
OIDC_UI_SUCCESS_URL=http://localhost:3000/login
# INSECURE dev-only: accept id_tokens without JWKS signature verification
OIDC_ALLOW_UNVERIFIED_TOKENS=false
