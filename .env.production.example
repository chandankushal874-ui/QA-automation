# =============================================================================
# PRODUCTION Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
#
# Then start the platform:
#   docker compose -f docker-compose.prod.yml up -d
# =============================================================================

# ── Database (PostgreSQL) ──
POSTGRES_USER=cbtp
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=cbtp

# ── Object Storage (MinIO) ──
S3_ACCESS_KEY=cbtp_minio
S3_SECRET_KEY=CHANGE_ME_to_a_strong_password
S3_BUCKET_NAME=cbtp-artifacts

# ── Reverse Proxy Port ──
# The platform will be accessible at http://YOUR_SERVER:PROXY_PORT
PROXY_PORT=80

# ── OpenRouter (AI fix generation) ──
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# ── GitHub (optional — for PR automation) ──
GITHUB_TOKEN=

# ── E2B (optional — remote sandbox for fix verification) ──
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT=120

# ── Firecrawl (optional — web scraping) ──
FIRECRAWL_API_KEY=

# ── Crawl Settings ──
MAX_CRAWL_DEPTH=10
MAX_PAGES_PER_JOB=1000
MAX_CRAWL_TIME_SECONDS=3600
PER_ENDPOINT_VISIT_BUDGET=5
CIRCUIT_BREAKER_THRESHOLD=10

# ── Frontend / Convex ──
# If using Convex Cloud, set this to your Convex deployment URL:
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# If self-hosting Convex, set it to your Convex server URL.
# The frontend Dockerfile bakes in the value from frontend/.env.local at build time.
# To override, edit frontend/.env.local before building.
# ── Crawl worker replicas (concurrent crawls) ──
# Each worker runs one crawl at a time with a real Playwright browser
# (~1-1.5 GB RAM per worker). 20 workers ≈ 30 GB RAM.
# 20 users × 5 active crawls = 100 jobs; workers drain the queue in order.
# Laptop/demo: 1. Small server: 4. Big server: 20 (≈30 GB RAM).
# Docker Desktop: set via --scale worker=N (compose deploy.replicas is Swarm-only).
WORKER_REPLICAS=1

# Multi-user auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
SEED_USERS=user1:user123:user1@localhost,user2:user123:user2@localhost
AUTH_DISABLED=false
JWT_SECRET=
